# Copy this file to terraform.tfvars (gitignored) and fill in the token
# from step 1 in README.md.

proxmox_endpoint            = "https://192.168.1.20:8006"
proxmox_bootstrap_api_token = "root@pam!bootstrap=00000000-0000-0000-0000-000000000000"

